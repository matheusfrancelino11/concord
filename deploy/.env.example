# Concord Production Environment Variables

# Domínio público do servidor (ex: concord.meudominio.com ou IP.sslip.io)
DOMAIN=concord.exemplo.com

# Banco de Dados PostgreSQL
DB_USER=concord
DB_PASSWORD=troque_por_uma_senha_muito_forte_aqui
DB_NAME=concord

# Autenticação JWT (gere uma string aleatória longa)
JWT_SECRET=gere_uma_chave_longa_e_aleatoria_com_openssl_rand_hex_32

# Configuração do LiveKit SFU (Voz e Vídeo)
LIVEKIT_URL=wss://livekit.concord.exemplo.com
LIVEKIT_KEY=concord_key
LIVEKIT_SECRET=troque_por_uma_chave_secreta_forte
