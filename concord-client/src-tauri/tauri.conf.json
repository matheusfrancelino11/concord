{
    "$schema":  "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
    "productName":  "Concord",
    "version":  "0.1.4",
    "identifier":  "com.concord.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Concord",
                                    "width":  1280,
                                    "height":  720,
                                    "minWidth":  940,
                                    "minHeight":  500,
                                    "resizable":  true,
                                    "decorations":  true,
                                    "center":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ]
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDNEFCQ0E0RDhDOEU4Q0YKUldUUDZNallwTHhLckZLcUphc3RxcjMxd1Bab0NzSEk0NUt0dnU2K2VyR1I2YWdMQk1GUFpyNVcK",
                                    "endpoints":  [
                                                      "https://concord.exemplo.com/updates/latest.json"
                                                  ]
                                }
                }
}
