# Concord Backend Environment Configuration
PORT=8080
ENV=development

# PostgreSQL Connection String
DATABASE_URL=postgres://concord:concord@127.0.0.1:5432/concord?sslmode=disable

# Authentication
JWT_SECRET=dev_secret_change_in_production_key
JWT_EXPIRY_HOURS=1
JWT_REFRESH_EXPIRY_DAYS=30

# Snowflake Generator Identifiers (0-31)
WORKER_ID=1
PROCESS_ID=1

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=tauri://localhost,http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost
